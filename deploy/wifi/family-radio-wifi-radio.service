[Unit]
Description=Fixed-operation Wi-Fi setup broker for the radio
After=NetworkManager.service family-radio-wifi-recover.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /usr/local/lib/family-radio/host/wifi_broker.py --radio-user family-radio
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/family-radio-wifi-status
UMask=0077
