[Unit]
Description=Family Radio setup HTTP on the protected setup address
After=NetworkManager.service family-radio-wifi.service
BindsTo=family-radio-wifi.service
PartOf=family-radio-wifi.service

[Service]
Type=simple
User=family-wifi
Group=family-wifi
ExecStart=/usr/bin/python3 -B /usr/local/lib/family-radio/host/wifi_portal.py --radio
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
