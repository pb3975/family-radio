[Unit]
Description=Family Radio setup-only DNS and DHCP
After=NetworkManager.service family-radio-wifi.service
BindsTo=family-radio-wifi.service
PartOf=family-radio-wifi.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/usr/local/lib/family-radio/deploy/wifi/dnsmasq.conf --pid-file=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID
