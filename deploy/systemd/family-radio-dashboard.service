[Unit]
Description=Family Radio parent dashboard
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=family-radio
WorkingDirectory=/usr/local/lib/family-radio
ExecStart=/usr/bin/python3 /usr/local/lib/family-radio/host/dashboard.py serve --host 127.0.0.1 --port 8090
UMask=0077
KillMode=control-group
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
